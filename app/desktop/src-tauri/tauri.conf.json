{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pcbmotorgen",
  "version": "0.5.0",
  "identifier": "dev.bertram.pcbmotorgen",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "pcbmotorgen",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12.5,
          "y": 21.5
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
