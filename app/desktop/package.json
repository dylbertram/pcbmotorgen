{
  "name": "pcbmotorgen-app-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:coreless": "playwright test e2e/housing-motion.spec.ts e2e/driver-simulation.spec.ts e2e/periodic-reference.spec.ts e2e/design-workspace.spec.ts e2e/simulation-dock.spec.ts e2e/magnet-count.spec.ts e2e/coil-layers.spec.ts e2e/coil-3d-z-scale.spec.ts e2e/coil-3d-fallback.spec.ts --config playwright.coreless.config.cjs --workers=1",
    "build:experimental:mac": "tauri build --debug --bundles app --no-sign --ci",
    "shot:mover": "playwright test e2e/mover-screenshots.spec.ts --project=desktop-tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workspace": "playwright test --config playwright.coreless.config.cjs --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "~1.48.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.8",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "svelte": "^5.56.9",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@lucide/svelte": "^1.55.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.2",
    "bits-ui": "^2.19.0",
    "katex": "^0.19.0",
    "three": "^0.186.1"
  }
}
